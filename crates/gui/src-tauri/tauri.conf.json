{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mac-cleaner",
  "version": "0.2.0",
  "identifier": "net.chandler.macclean",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "mac-cleaner",
        "width": 920,
        "height": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
